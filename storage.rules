rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /portfolio/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /videos-portfolio/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /floor-plans-portfolio/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
